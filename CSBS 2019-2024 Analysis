# Prediction of Cybersecurity Threats (2019-2024)
get_props <- function(df, yr) {
  df %>%
    filter(!is.na(freq), !freq %in% c("Refused","Don't know")) %>%
    count(freq) %>%
    mutate(year = yr,
           proportion = n / sum(n)) %>%
    select(year, freq, proportion)
}

actual_2019 <- get_props(survey2019_cleaned, 2019)
actual_2024 <- get_props(survey2024_cleaned, 2024)

# 2. Predict 2024 from 2019 and 2029 from 2024
predict_one <- function(actual_df, future_year) {
  actual_df %>%
    group_by(freq) %>%
    do({
      model <- lm(proportion ~ year, data = .)
      pred  <- predict(model, newdata = data.frame(year = future_year))
      data.frame(year = future_year, proportion = pred)
    }) %>%
    ungroup()
}

pred_2024 <- predict_one(actual_2019, 2024) %>% mutate(type = "Predicted")
pred_2029 <- predict_one(actual_2024, 2029) %>% mutate(type = "Predicted")

# 3. Tag actuals
actual_2019 <- actual_2019 %>% mutate(type = "Actual")
actual_2024 <- actual_2024 %>% mutate(type = "Actual")

# 4. Build line‐segment data for the two dashed connections
line_19_24 <- bind_rows(
  actual_2019 %>%   select(year, freq, proportion),
  pred_2024        %>% select(year, freq, proportion)
)

line_24_29 <- bind_rows(
  actual_2024 %>%   select(year, freq, proportion),
  pred_2029        %>% select(year, freq, proportion)
)

# 5. Combine all points for plotting
all_points <- bind_rows(actual_2019, actual_2024, pred_2024, pred_2029)

# 6. Single plot
ggplot() +
  # dashed lines
  geom_line(data = line_19_24, aes(x = year, y = proportion, color = freq, group = freq),
            linetype = "dashed", size = 0.5) +
  geom_line(data = line_24_29, aes(x = year, y = proportion, color = freq, group = freq),
            linetype = "dashed", size = 0.5) +
  # points
  geom_point(data = all_points,
             aes(x = year, y = proportion, shape = type, color = freq),
             size = 2) +
  scale_shape_manual(values = c(16, 17)) +  # circle=actual, triangle=predicted
  labs(
    title = "Cyber Attack Frequency: 2019→2024 Predicted & 2024→2029 Predicted",
    x = "Year",
    y = "Proportion of Businesses",
    color = "Attack Frequency Level",
    shape = ""
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")

