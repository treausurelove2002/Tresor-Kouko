#Correlation Tests

# Attitudes to Cybersecurity
attitude_vars19 <- survey2019_cleaned[, c("att_right_skills", "att_enough_people", "att_act_on_advise", "att_informed_choice")]

attitude_vars_num19 <- data.frame(lapply(attitude_vars19, function(x) {
  if (is.factor(x) || is.character(x)) {
    as.numeric(factor(x, levels = unique(x)))} else {x}}))

cor_matrix_att19 <- cor(attitude_vars_num19, use = "complete.obs", method = "spearman")
print(cor_matrix_att19)


